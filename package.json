{
  "name": "blender-icon-grid",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "postbuild": "node scripts/postbuild.ts",
    "lint": "svelte-check --tsgo && prettier --check .",
    "format": "prettier --write .",
    "deploy": "vite build && node scripts/postbuild.ts && node scripts/deploy.ts",
    "icons": "node scripts/gen-manifest.js && node scripts/copyAll.ts && node scripts/convertAll.ts && node scripts/optimizeSvg.ts"
  },
  "type": "module",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jimp": "^1.6.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svgo": "^4.1.0",
    "typescript": "6",
    "vite": "^8.3.0"
  }
}
